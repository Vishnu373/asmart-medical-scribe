# Dependencies
node_modules/

# Frontend build output
dist/

# Rust / Tauri build output
src-tauri/target/
src-tauri/gen/

# Graphify
graphify-out/

# implementation.md file
docs/implementation.md

# uploading models, models folder, web url
scripts/models/
website/

# private key
~/

# Model weights (downloaded / vendored separately, never committed)
src-tauri/resources/models/*
!src-tauri/resources/models/.gitkeep
# Exception: the Silero VAD model is small (~1.8 MB) and required at startup, so
# it is committed; the large STT/LLM weights stay excluded by the rule above.
!src-tauri/resources/models/silero_vad_v4.onnx

# Local database / encrypted key blobs (PHI — never commit)
*.db
*.sqlite
*.sqlite3

# Editor / OS
.DS_Store
*.log

# Local secrets (R2 upload credentials)
.env

# Claude files
.claude/
CLAUDE.md
# Staged from target/release by scripts/stage_llama_dlls.mjs at bundle time —
# a committed copy would go stale against the rlib and crash at model load.
src-tauri/libs/ggml*.dll
src-tauri/libs/llama*.dll
src-tauri/libs/mtmd*.dll
# OpenSSL is staged by the same script: its DLL name carries the ABI version, so a
# committed copy stops matching the build the day the host's OpenSSL is bumped.
src-tauri/libs/libcrypto*.dll
src-tauri/libs/libssl*.dll
