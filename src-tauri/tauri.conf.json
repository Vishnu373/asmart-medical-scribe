{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "asmart_medical_scribe",
  "version": "0.1.3",
  "identifier": "com.asmartmedicalscribe.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ASmart Medical Scribe",
        "width": 1100,
        "height": 740,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": {
      "models/**/*": "models/",
      "libs/*": "./"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "./installer-hooks.nsh"
      }
    }
  },
  "plugins" : {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUxMEM3QjFBNTlGMjk4ODMKUldTRG1QSlpHbnNNNFdSLzA1NGtsUHpmU3k2emRhalJ5YVQ2YkpHVzJ1MDJBWVZ4a0pHeHNlTUEK",
      "endpoints": [
        "https://pub-1f1bec0a40cf47528c6f179d427ffa22.r2.dev/latest.json"
      ]
    }
  }
}